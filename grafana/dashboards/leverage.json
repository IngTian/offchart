      "id": 2,
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "offchart"
      },
      "title": "Customer receivables as a share of household equity holdings",
      "description": "THE PANEL TO READ, and the reason the denominator is part of this source. The level below is at an all-time high; this says the borrowing is a smaller share of the equities it is secured against than at any comparable peak -- 1.42% now against 3.05% at the 2000:Q1 top and 2.80% in 2007:Q2. A level that grows 593x since 1945 mostly records the economy getting bigger, which is why lib/metrics' third rule says a normaliser must be stated rather than assumed. Denominator is Z.1 FL153064105, households and nonprofit organizations' corporate equity holdings: a stock over a stock, not a stock over an annualised flow like GDP.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "offchart"
          },
          "queryType": "time series",
          "rawQueryText": "SELECT ts/1000 AS time, pct_of_household_equities AS 'share of equity holdings' FROM board_leverage WHERE ts BETWEEN $__from AND $__to ORDER BY ts",
          "queryText": "SELECT ts/1000 AS time, pct_of_household_equities AS 'share of equity holdings' FROM board_leverage WHERE ts BETWEEN $__from AND $__to ORDER BY ts",
          "timeColumns": [
