    {
      "id": 7,
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "offchart"
      },
      "title": "Forced to trade per 1% move in $family \u2014 by leverage",
      "description": "What a 1% move in this index obliges ProShares' funds to trade, split by multiple: (multiple^2 - multiple) x assets x 1%. STACKED, and here that is correct rather than the usual error -- these are disjoint funds on the same index, and their demand genuinely adds. Note -3x carries coefficient 12 against +3x's 6, so an inverse fund rebalances twice as hard per dollar of assets; and the bull and bear sides add rather than offset, because a bear fund's short exposure grows as the index falls, so it must buy too. One issuer only: Direxion is absent because it publishes no history, and it is the larger house in the chip complex.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "offchart"
          },
          "queryType": "time series",
          "rawQueryText": "SELECT ts/1000 AS time, MAX(CASE WHEN multiple = 3.0 THEN rebalance_1pct_usd END) AS '+3x', MAX(CASE WHEN multiple = 2.0 THEN rebalance_1pct_usd END) AS '+2x', MAX(CASE WHEN multiple = -2.0 THEN rebalance_1pct_usd END) AS '-2x', MAX(CASE WHEN multiple = -3.0 THEN rebalance_1pct_usd END) AS '-3x' FROM board_flows WHERE index_family='$family' AND ts BETWEEN $__from AND $__to GROUP BY ts ORDER BY ts",
          "queryText": "SELECT ts/1000 AS time, MAX(CASE WHEN multiple = 3.0 THEN rebalance_1pct_usd END) AS '+3x', MAX(CASE WHEN multiple = 2.0 THEN rebalance_1pct_usd END) AS '+2x', MAX(CASE WHEN multiple = -2.0 THEN rebalance_1pct_usd END) AS '-2x', MAX(CASE WHEN multiple = -3.0 THEN rebalance_1pct_usd END) AS '-3x' FROM board_flows WHERE index_family='$family' AND ts BETWEEN $__from AND $__to GROUP BY ts ORDER BY ts",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "width": 200
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 55,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "left",
            "axisWidth": 80,
            "axisLabel": "",
            "axisColorMode": "text",
